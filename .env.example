# ──────────────────────────────────────────────────────────────────────
# AI 搜索 POC (feature/ai-search-poc 分支)
# 不填这些变量 → /api/recommend 自动 fallback 到 mock,UI 显示"演示数据"badge。
# 不要把真实 .env 提交到仓库 (.gitignore 已经排除 .env / .env.*)。
# ──────────────────────────────────────────────────────────────────────

# 可选:perplexity (默认,完整实现) | openai (占位,目前会直接抛错走 fallback)
AI_PROVIDER=perplexity

# Perplexity / OpenAI 的 API key。留空 = 服务端永远走 mock。
AI_API_KEY=

# 可选:覆盖默认模型 (Perplexity 默认 "sonar")。
# AI_MODEL=sonar

# 调一次 AI 的最大耗时 (毫秒)。超过这个时间走 mock fallback。
# 范围 1000–30000,默认 10000。
AI_SEARCH_TIMEOUT_MS=10000
